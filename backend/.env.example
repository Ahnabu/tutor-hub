# ==============================================================================
# TUTORHUB BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to '.env' in the backend directory:
#   cp .env.example .env
# Then fill in the real values according to the instructions below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Port on which the Express server will listen (default: 5000)
PORT=5000

# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# Base URL prefix for all API routes (default: /api/v1)
API_PREFIX=/api/v1

# Frontend Origin for CORS allow-listing (credentials allowed)
# In local development: http://localhost:3000
# In production: https://your-frontend-domain.vercel.app
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# HOW TO OBTAIN:
# - Local Docker development (Recommended):
#   Run `docker compose up -d` at project root. It starts a single-node replica set
#   required for multi-document ACID transactions.
#   Connection URI: mongodb://localhost:27017/tutorhub?replicaSet=rs0
#
# - Production (MongoDB Atlas):
#   1. Sign up / Log in to https://cloud.mongodb.com
#   2. Create a Project and Deploy a Database (Shared M0 is free).
#   3. Under "Security" -> "Database Access", create a database user and password.
#   4. Under "Security" -> "Network Access", add your hosting provider's IP (or 0.0.0.0/0).
#   5. Go to "Database" -> Click "Connect" -> Choose "Drivers" (Node.js).
#   6. Copy connection string: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tutorhub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/tutorhub?replicaSet=rs0

# ------------------------------------------------------------------------------
# 3. JWT & COOKIE SECURITY SECRETS
# ------------------------------------------------------------------------------
# HOW TO GENERATE:
# Generate unique 256-bit cryptographically secure strings by running this in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Run it 3 times to get 3 unique secrets. Never reuse or share these secrets.

# Secret key used to sign and verify short-lived access JWTs (15 min)
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string_min_32_chars

# Secret key used to sign and verify long-lived refresh JWTs (7 days)
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex_string_min_32_chars

# Expiration strings (compatible with jsonwebtoken: '15m', '7d', etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Secret key used by cookie-parser to sign and tamper-protect HTTP-only cookies
COOKIE_SECRET=replace_with_third_64_char_random_hex_string_min_32_chars

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA & DOCUMENT STORAGE
# ------------------------------------------------------------------------------
# HOW TO OBTAIN:
# TutorHub uses Cloudinary for avatars, session attachments, and authenticated ID verification docs.
# 1. Sign up for a free account at https://cloudinary.com
# 2. Go to your Cloudinary Console / Dashboard (https://console.cloudinary.com/console).
# 3. At the top of the dashboard or in Settings -> Access Keys, you will see:
#    - "Cloud name" -> paste into CLOUDINARY_CLOUD_NAME
#    - "API Key" -> paste into CLOUDINARY_API_KEY
#    - "API Secret" -> click to reveal and paste into CLOUDINARY_API_SECRET
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL NOTIFICATIONS & VERIFICATION
# ------------------------------------------------------------------------------
# HOW TO OBTAIN:
# - Local Development (Mailpit):
#   The root `docker-compose.yml` runs Mailpit, capturing all outgoing emails locally.
#   SMTP Host: localhost
#   SMTP Port: 1025
#   SMTP Secure: false
#   No username or password needed.
#   View all received emails in your browser at: http://localhost:8025
#
# - Production (Brevo / SendGrid / Resend / Google Workspace):
#   - Brevo (Free 300 emails/day): Sign up at https://brevo.com -> SMTP & API -> Create SMTP key.
#     Host: smtp-relay.brevo.com, Port: 587, Secure: false, User: your_email, Pass: your_smtp_key.
#   - Gmail with App Password:
#     Host: smtp.gmail.com, Port: 587, Secure: false, User: your@gmail.com,
#     Pass: 16-character App Password generated at https://myaccount.google.com/apppasswords.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TutorHub <noreply@tutorhub.local>"

# ------------------------------------------------------------------------------
# 6. INITIAL ADMIN SEEDING (npm run seed:admin)
# ------------------------------------------------------------------------------
# Credentials used by the bootstrapping script to create the initial super-admin.
# Change these before running `npm run seed:admin`.
ADMIN_EMAIL=admin@tutorhub.local
ADMIN_PASSWORD=AdminSecurePassword123!
